{
  "name": "agency-crm",
  "version": "3.2.0",
  "description": "Production-grade, open-source Studio Command CRM for creative agencies, consultancies, and digital delivery teams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IsmeetPandey/agency-crm.git"
  },
  "homepage": "https://crm-mnjo.vercel.app/",
  "keywords": [
    "crm",
    "agency-crm",
    "agencyos",
    "supabase",
    "react",
    "typescript",
    "tailwind",
    "kanban",
    "erp",
    "open-source"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "biome check .",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.66.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^5.0.0"
  }
}
